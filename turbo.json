{
  "$schema": "https://turborepo.com/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "lint": {
      "dependsOn": [
        "deps"
      ]
    },
    "check-types": {
      "dependsOn": [
        "deps"
      ]
    },
    "test": {
